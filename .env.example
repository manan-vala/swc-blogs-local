# Copy to .env and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/swc_blogs

# Notion — one internal integration, shared by every club (design doc §11:
# "Notion token has no owner" — document who holds this in the team handover doc)
NOTION_TOKEN=
NOTION_POSTS_DATABASE_ID=
NOTION_TEMPLATE_PAGE_ID=

# Institute SSO — club secretary sign-in (§7). IITG accounts are
# Microsoft Entra ID, so this is the standard Entra authorization-code
# flow. Register the app at https://entra.microsoft.com; these names
# match the Students' Senate Portal's so one app registration's values
# work in both without translation.
#
# MICROSOFT_GRAPH_REDIRECT_URI must be listed VERBATIM as a Redirect URI
# on the Azure app (Authentication -> Web) — including the /blogs
# basePath. Entra rejects the exchange on any mismatch, trailing slash
# included. For local dev without nginx, that's
# http://localhost:4000/api/auth/sso/callback
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_REDIRECT_URI=https://swc.iitg.ac.in/blogs/api/auth/sso/callback

# Session signing secret — shared by BOTH services. apps/api issues the
# cookie (SSO callback + TOTP verify), apps/web verifies it server-side
# to render the dashboard/admin panel (§7). Must be identical on both.
SESSION_SECRET=

# Public API base the browser calls from dashboard client components.
# Defaults to the nginx-proxied path in production; override for local
# dev if web (3000) and api (4000) run without nginx in front of them,
# e.g. http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=

# Only needed in that same no-nginx local setup — web and api are then
# two different origins, and every browser call this API serves besides
# the SSO callback is a credentialed fetch (cookies), which the browser
# silently blocks at the CORS preflight without this. Leave unset in
# production: nginx same-origins everything under /blogs there, so no
# CORS is involved at all. e.g. http://localhost:3000
DEV_CORS_ORIGIN=

# TOTP secret encryption at rest (§7) — 32+ random bytes, e.g. `openssl rand -hex 32`
TOTP_ENCRYPTION_KEY=

# Internal container URL INCLUDING the /blogs basePath — see apps/api/src/lib/env.ts
WEB_URL=http://web:3000/blogs
REVALIDATE_SECRET=

MEDIA_DIR=/app/media

# Postgres image env (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=swc_blogs
