# Copy to .env and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/swc_blogs

# Notion — one internal integration, shared by every club (design doc §11:
# "Notion token has no owner" — document who holds this in the team handover doc)
NOTION_TOKEN=
NOTION_POSTS_DATABASE_ID=
NOTION_TEMPLATE_PAGE_ID=

# Institute SSO — club secretary sign-in (§7)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://swc.iitg.ac.in/blogs/api/auth/sso/callback

# Session signing secret — shared by BOTH services. apps/api issues the
# cookie (SSO callback + TOTP verify), apps/web verifies it server-side
# to render the dashboard/admin panel (§7). Must be identical on both.
SESSION_SECRET=

# Public API base the browser calls from dashboard client components.
# Defaults to the nginx-proxied path in production; override for local
# dev if web (3000) and api (4000) run without nginx in front of them,
# e.g. http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=

# TOTP secret encryption at rest (§7) — 32+ random bytes, e.g. `openssl rand -hex 32`
TOTP_ENCRYPTION_KEY=

# Internal container URL INCLUDING the /blogs basePath — see apps/api/src/lib/env.ts
WEB_URL=http://web:3000/blogs
REVALIDATE_SECRET=

MEDIA_DIR=/app/media

# Postgres image env (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=swc_blogs
